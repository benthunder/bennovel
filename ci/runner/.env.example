# Copy to .env (cp .env.example .env && chmod 600 .env) and fill ACCESS_TOKEN.
# Never commit .env.

# Fine-grained PAT, only repository benthunder/bennovel,
# permission "Administration: Read and write" (needed to register runners).
ACCESS_TOKEN=github_pat_xxx

RUNNER_SCOPE=repo
REPO_URL=https://github.com/benthunder/bennovel
# The workflow picks runners that have ALL of: self-hosted, linux, x64, bennovel-build
LABELS=bennovel-build
RUNNER_WORKDIR=/_work
# The runner removes itself from GitHub when the container stops.
DISABLE_AUTOMATIC_DEREGISTRATION=false

# RAM cap per runner container (2 runners). 16 GB host -> 7g each.
RUNNER_MEM_LIMIT=7g

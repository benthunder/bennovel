<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keeps AI translation running with the screen off: a foreground service with a
         progress notification, a partial wake lock and a Wi-Fi lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="app.bennovel.backgroundwork.TranslateService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <!-- Starts the app afresh when it is opened again while a translation went on with
             no window (see Relaunch.kt). -->
        <activity
            android:name="app.bennovel.backgroundwork.Relaunch"
            android:exported="false"
            android:process=":relaunch"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
